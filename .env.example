# Merchant API key from your gateway dashboard (Merchant Service → Generate API key).
# Also used to verify webhook signatures. Server-side only — never put it in the page.
OXAPAY_MERCHANT_API_KEY=

PORT=4000

# Password for /admin, where you create fixed-amount payment links (min 10 chars).
# Leave empty to disable the admin page.
ADMIN_PASSWORD=admin

# Public HTTPS base URL of this server. When set, the gateway POSTs status
# updates to $PUBLIC_URL/webhooks/payment. Leave empty to rely on polling only.
PUBLIC_URL=

# Behind a reverse proxy (Railway, Nginx, Cloudflare): set to 1 so rate limiting
# uses the real client IP from X-Forwarded-For.
TRUST_PROXY=0

# ── Your branding ─────────────────────────────────────────────
BRAND_NAME=Payments
BRAND_COLOR=#2563EB
# Small line under the card, e.g. "Need help? support@yourcompany.com"
SUPPORT_TEXT=

# ── Payment rules ─────────────────────────────────────────────
# Currencies the payer can price the amount in (first = default).
FIAT_CURRENCIES=INR,USD
# Coin:Network pairs to offer, or * for everything your account accepts.
# Network can be the name or a standard: USDT:Tron, USDT:TRC20, USDT:BSC, BTC:Bitcoin
ALLOWED_COINS=USDT:Tron,USDT:BSC
# Minutes before the deposit address expires (15–2880).
PAYMENT_LIFETIME_MIN=30
# 1 = payer pays the network fee, 0 = you do. Empty = your dashboard setting.
FEE_PAID_BY_PAYER=
# Max % underpayment still accepted as paid (0–60). Empty = dashboard setting.
UNDERPAID_COVERAGE=
MIN_AMOUNT=1
MAX_AMOUNT=

# Set to 1 to run without a key: fake payments, no money moves.
MOCK=0
